// Build settings for the Murmur app target.

PRODUCT_NAME = Murmur
PRODUCT_BUNDLE_IDENTIFIER = io.github.garfield-oo7.Murmur
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
ARCHS = arm64
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
ENABLE_HARDENED_RUNTIME = YES
CODE_SIGN_ENTITLEMENTS = Config/Murmur.entitlements
ENABLE_USER_SCRIPT_SANDBOXING = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_OBJC_ARC = YES
// One self-contained executable. The Debug-only Murmur.debug.dylib split (for SwiftUI
// Previews) breaks when scripts/build.sh re-signs the bundle under hardened runtime.
ENABLE_DEBUG_DYLIB = NO

// Info.plist is generated from these keys.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Murmur
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSMicrophoneUsageDescription = Murmur listens to your microphone while you hold the dictation hotkey and turns your speech into text on your Mac.
INFOPLIST_KEY_NSHumanReadableCopyright = Copyright © 2026 garfield-oo7

// Not sandboxed: Accessibility (keystrokes, AX insertion) is unavailable to sandboxed apps.
ENABLE_APP_SANDBOX = NO

// Xcode signs ad-hoc so the project builds on any Mac. scripts/build.sh re-signs the
// installed copy with the stable "Murmur Dev" identity (scripts/make-dev-cert.sh) so
// macOS privacy permissions survive rebuilds.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
